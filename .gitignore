# ── Dependencies ───────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Build output ───────────────────────────────────────────────────────────
dist/
dist-ssr/
build/
.vercel/

# ── Environment and secrets ────────────────────────────────────────────────
# Never commit these. Commit .env.example instead, with keys but no values.
.env
.env.*
!.env.example
*.pem
*.key

# ── Logs ───────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Editors and OS ─────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Local caches ───────────────────────────────────────────────────────────
.cache/
.temp/
coverage/
*.local

# ── AI tooling ─────────────────────────────────────────────────────────────
# Installed skill packages and assistant scratch state, not project source —
# ignored for the same reason node_modules is. Remove a line here if you do want
# that config shared with whoever clones the repo.
.kiro/
.agents/
.aider-desk/
.claude/
.codex/
.impeccable/
skills-lock.json
