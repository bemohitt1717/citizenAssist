# Copy this file to .env and fill in the values. Never commit .env itself.

PORT=5000
NODE_ENV=development

# MongoDB connection string.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database?appName=app-name

# Secret used to sign session tokens. Use a long random string.
JWT_SECRET=your-long-random-secret-here

# Google OAuth credentials for "Continue with Google".
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# Where the frontend runs, for CORS.
# Development: http://localhost:5173
# Production: https://your-vercel-app.vercel.app
CLIENT_ORIGIN=http://localhost:5173
