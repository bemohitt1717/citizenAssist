# Copy this file to .env and fill in the values. Never commit .env itself.

PORT=5000
NODE_ENV=development

# MongoDB connection string.
MONGODB_URI=

# Secret used to sign session tokens. Use a long random string.
JWT_SECRET=

# Google OAuth, for "Continue with Google".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where the frontend runs, for CORS.
CLIENT_ORIGIN=http://localhost:5173
