# Copy this file to .env and fill in the values. Never commit .env itself.

PORT=5000
NODE_ENV=production

# MongoDB connection string.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database?appName=app-name

# Secret used to sign access tokens. Use a long random string.
JWT_SECRET=your-long-random-secret-here

# Secret used to sign refresh tokens. Use a different long random string.
JWT_REFRESH_SECRET=your-refresh-secret-here

# Google OAuth credentials for "Continue with Google".
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# Where the frontend runs, for CORS. Comma-separated for multiple origins.
# Development: http://localhost:5173
# Production: https://your-vercel-app.vercel.app
CLIENT_URL=http://localhost:5173,https://your-vercel-app.vercel.app

# Cookie domain for production (optional, for subdomain cookies)
# Leave empty for localhost. For production with custom domain, set to .yourdomain.com
COOKIE_DOMAIN=
